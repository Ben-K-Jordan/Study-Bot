{
  "name": "study-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Exam planning and retrieval practice from your own course files, with spaced review scheduled back from each exam date.",
  "keywords": [
    "study",
    "retrieval-practice",
    "spaced-repetition",
    "flashcards",
    "learning-science",
    "nextjs"
  ],
  "homepage": "https://github.com/Ben-K-Jordan/Study-Bot#readme",
  "bugs": {
    "url": "https://github.com/Ben-K-Jordan/Study-Bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ben-K-Jordan/Study-Bot.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/__tests__/integration/**'",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx scripts/worker.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed-research": "tsx scripts/seed-research.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "nanoid": "^3.3.20",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
