# ==============================================================
# Study Bot environment configuration
#
# Quick start: run `npm run setup`. It copies this file to .env,
# generates the secrets marked "auto-filled" below, starts the
# database via Docker, and applies migrations.
#
# The defaults run fully offline: mock AI, console email, and a
# fake Google Calendar client.
# ==============================================================

# --- Database -------------------------------------------------
# Matches docker-compose.yml, which maps Postgres to HOST port 5433
# (5433 avoids clashing with a locally installed Postgres on 5432).
# If you run your own Postgres instead of Docker, point this at it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/studybot?schema=public"

# --- App URL --------------------------------------------------
BASE_URL="http://localhost:3000"         # public origin; used in session links, emails, and OAuth redirects

# --- Authentication (NextAuth) --------------------------------
NEXTAUTH_URL="http://localhost:3000"     # must match the origin you browse to; https enables secure cookies
NEXTAUTH_SECRET=""                       # auto-filled by `npm run setup` (or: openssl rand -base64 32)

# Require users to verify their email address before signing in.
# Leave off unless real SMTP is configured below; with the console
# provider, verification links only appear in the server logs.
# REQUIRE_EMAIL_VERIFICATION="true"

# --- Admin & Security -----------------------------------------
ADMIN_USER_IDS=""                        # comma-separated user IDs allowed to call the /api/admin/* endpoints (there is no admin page)

# WARNING: ALLOW_TEST_AUTH makes the app trust the X-User-Id header
# as the signed-in user. It exists ONLY for automated tests, and a
# production build ignores it unless CI=true. Leave it commented out.
# ALLOW_TEST_AUTH="true"

# --- Logging --------------------------------------------------
LOG_LEVEL="info"                         # debug | info | warn | error

# --- Email ----------------------------------------------------
EMAIL_PROVIDER="console"                 # console (print to server logs) | smtp
SMTP_HOST=""                             # SMTP server host, required when EMAIL_PROVIDER="smtp"
SMTP_PORT="587"                          # SMTP port; 465 uses TLS from the start
SMTP_USER=""                             # SMTP username
SMTP_PASS=""                             # SMTP password
SMTP_FROM="Study Bot <noreply@studybot.app>"  # From header on outgoing mail

# --- Uploads --------------------------------------------------
UPLOAD_DIR="./data/uploads"              # where uploaded documents are stored, relative to the project root

# --- Google Calendar Integration ------------------------------
GOOGLE_PROVIDER="fake"                   # fake (in-memory, for dev and tests) | real (calls Google)
GOOGLE_CLIENT_ID=""                      # OAuth client ID, required when GOOGLE_PROVIDER="real"
GOOGLE_CLIENT_SECRET=""                  # OAuth client secret, required when GOOGLE_PROVIDER="real"
GOOGLE_REDIRECT_URI=""                   # defaults to BASE_URL + /api/integrations/google/callback
TOKEN_ENC_KEY=""                         # auto-filled by `npm run setup`; encrypts stored OAuth tokens (32 bytes: 64 hex or 44 base64 chars)
GOOGLE_SYNC_CONCURRENCY="3"              # max concurrent Google Calendar calls while publishing or unpublishing a plan

# --- AI Control Plane -----------------------------------------
AI_PROVIDER="mock"                       # mock (canned output, for tests) | openai
OPENAI_API_KEY=""                        # required when AI_PROVIDER="openai"
AI_MODEL_ANSWER="gpt-4o-mini"            # model for questions, feedback, chat, and plans
AI_MODEL_EMBED="text-embedding-3-small"  # model for document embeddings
AI_REQUEST_TIMEOUT_MS="60000"            # abort AI provider requests after this many ms
AI_CACHE_TTL_SECONDS="3600"              # how long identical AI responses are reused
AI_DAILY_COST_CAP_USD="1.0"              # max spend per user per day
AI_MONTHLY_COST_CAP_USD="10.0"           # max spend per user per month
AI_DISABLED="false"                      # emergency kill switch; "true" blocks all AI calls
# MOCK_AI_MALFORMED="1"                  # test-only: makes the mock provider emit malformed output

# --- Background Worker (npm run worker) -----------------------
JOB_WORKER_CONCURRENCY="2"               # jobs processed in parallel
JOB_POLL_INTERVAL_MS="2000"              # how often the worker checks for new jobs

# --- Hybrid Search --------------------------------------------
HYBRID_SEARCH_ENABLED="false"            # "true" adds embedding search to full-text search (needs pgvector and the worker)

# --- Set by tooling; do not set these here --------------------
# NODE_ENV                               set by next dev / next build / next start
# CI                                     set by CI runners; lets ALLOW_TEST_AUTH work in a production build
